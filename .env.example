# OpenRouter key — used for Jev (typesafe/jev-1.13) and the OpenRouter LLM fallback
OPENROUTER_API_KEY=sk-or-v1-...
# Google AI Studio key — https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=...
# Optional
HERJEV_WEBHOOK_TOKEN=change-me
# Optional: bearer token of the MCP endpoint for agents (mcp_server.token)
# HERJEV_MCP_TOKEN=<openssl rand -hex 32>
# Optional: Teams group chat for alerts (scripts/setup-teams.sh fills these)
# TEAMS_APP_ID=<entra app (client) id>
# TEAMS_TENANT_ID=<entra directory (tenant) id>
# TEAMS_CHAT_ID=19:...@thread.v2

# docker compose settings (copy to .env). API keys go in $HERJEV_DATA/.env instead.
HERJEV_DATA=./herjev-data
HERJEV_UID=1000              # `id -u` on the host
HERJEV_GID=1000              # `id -g` on the host
HERJEV_WEBHOOK_PORT=8787
HERJEV_SYSLOG_PORT=5514
HERJEV_MCP_PORT=8789         # MCP endpoint for agents, published on 127.0.0.1
HERJEV_POSTGRES_PORT=5432    # local Postgres, published on 127.0.0.1

# Local Postgres. The passwords only apply when the herjev-pg volume is first created.
POSTGRES_PASSWORD=postgres
HERJEV_WATCHER_PASSWORD=watcher
HERJEV_PORTAL_PASSWORD=portal
# The watcher's store; the default points at the compose Postgres as herjev_watcher.
# HERJEV_DATABASE_URL=postgresql://herjev_watcher:watcher@postgres:5432/postgres
